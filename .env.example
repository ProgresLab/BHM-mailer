SMTP_ENABLED=true
SMTP_HOST=send.one.com
SMTP_PORT=465
SMTP_USER=marketing@bhm-chemicals.com
SMTP_PASSWORD=
SMTP_FROM_NAME="BHM Chemicals"
SMTP_FROM_EMAIL=marketing@bhm-chemicals.com
SMTP_REPLY_TO=info@bhm-chemicals.com
SMTP_ENVELOPE_FROM=marketing@bhm-chemicals.com
SMTP_USE_SSL=true
SMTP_USE_TLS=false
PUBLIC_UNSUBSCRIBE_BASE_URL=https://unsubscribe.mail.bhm-chemicals.com/unsubscribe
ADMIN_NOTIFICATION_EMAIL=info@bhm-chemicals.com
EMAIL_SEND_DELAY_SECONDS=20
UNSUBSCRIBE_SECRET=

# Campaign worker enforces a fixed 20-second interval; legacy delay/skip flags do not override it.
# Optional isolated QA paths (leave unset for normal local use): BHM_DB_PATH, BHM_ASSET_DIR
